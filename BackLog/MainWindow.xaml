<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        mc:Ignorable="d"
        Title="待办事项" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Icon="sticky-notes.ico">
    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="8" ShadowDepth="2" Color="#20000000" Opacity="0.2"/>

        <!-- Boolean to Visibility Converter -->
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>



        <!-- 现代化复选框样式 -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder"
                                        Width="22" Height="22"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="2"
                                        CornerRadius="6">
                                    <TextBlock x:Name="CheckMark"
                                               Text="✓"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- 删除按钮样式 -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F44336"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 添加按钮样式 -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#666"/>
                    <Setter Property="BorderBrush" Value="#CCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 任务文本样式 -->
        <Style x:Key="TaskTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="WordEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Foreground" Value="#AAA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 任务项样式 -->
        <Style x:Key="TaskItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条Thumb样式 -->
        <Style TargetType="Thumb" BasedOn="{StaticResource {x:Type Thumb}}">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Header -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Grid.ColumnSpan="2" Background="White" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="待办事项" FontSize="24" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    <Border Background="#F5F5F5" CornerRadius="4" Padding="5,2,5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.4" FontSize="14" Foreground="#888"/>
                    </Border>
                    <TextBox x:Name="StatusTextBox" Height="25" Margin="10,0,0,0" Background="#F5F5F5" BorderBrush="Transparent" Foreground="#888" FontSize="14" VerticalAlignment="Center" TextAlignment="Left" VerticalContentAlignment="Center" IsReadOnly="True" IsHitTestVisible="True" Focusable="True" Cursor="IBeam"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock x:Name="AutoSaveStatusText" Width="120" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="0,0,5,0"/>                    
                    <Button Content="💾 保存" Style="{StaticResource AddButtonStyle}" Click="ExportData_Click" Margin="0,0,10,0"/>
                    <Button Content="📥 导入" Style="{StaticResource AddButtonStyle}" Click="ImportData_Click" Margin="0,0,10,0"/>

                </StackPanel>
            </Grid>
        </Border>

            <!-- 左侧分类选择栏 -->
            <Border x:Name="LeftCategoryBorder" Grid.Row="1" Grid.Column="0" Background="#FFFFFF" Margin="20,25,0,20" Padding="20" CornerRadius="10" Effect="{StaticResource ShadowEffect}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,0,20,0" Background="Transparent">
                    <StackPanel>
                    <!-- 搜索栏 -->
                    <Border Background="#F5F5F5" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,8,0"/>
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     Grid.Column="1"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="📋 概览" FontSize="16" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 添加新分类按钮 -->
                    <Button Content="+ 新建分类" Style="{StaticResource AddButtonStyle}" Click="AddCategory_Click" Margin="0,0,0,15"/>

                    <!-- 分类列表 -->
                    <ItemsControl x:Name="CategoryListControl" ItemsSource="{Binding DateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <Border Background="Transparent"
                                            Padding="15,12,15,12"
                                            CornerRadius="8"
                                            PreviewMouseLeftButtonDown="Category_MouseLeftButtonDown">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#333"
                                                           VerticalAlignment="Center"
                                                           Grid.Column="0"/>
                                                <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                                           FontSize="12"
                                                           Foreground="#888"
                                                           VerticalAlignment="Center"
                                                           Grid.Column="1"
                                                           Margin="5,0,0,0"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Progress}"
                                                         Maximum="100"
                                                         Height="4"
                                                         Margin="0,10,0,0"
                                                         Background="#E0E0E0"
                                                         Foreground="#4CAF50"
                                                         BorderThickness="0"/>
                                        </StackPanel>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!-- 右键菜单 -->
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名" Click="RenameCategory_Click" Tag="{Binding}"/>
                                                <MenuItem Header="删除" Click="DeleteCategory_Click" Tag="{Binding}"/>
                                                <MenuItem Header="清除" Click="ClearCategory_Click" Tag="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="移动">
                                                    <MenuItem Header="上移" Click="MoveCategoryUp_Click" Tag="{Binding}" Visibility="{Binding IsFirst, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                                    <MenuItem Header="下移" Click="MoveCategoryDown_Click" Tag="{Binding}" Visibility="{Binding IsLast, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                                    <MenuItem Header="置顶" Click="MoveCategoryToTop_Click" Tag="{Binding}" Visibility="{Binding IsFirst, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                                    <MenuItem Header="置底" Click="MoveCategoryToBottom_Click" Tag="{Binding}" Visibility="{Binding IsLast, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="复制">
                                                    <MenuItem Header="【】样式" Click="CopyPageStyle1_Click" Tag="{Binding}"/>
                                                    <MenuItem Header="-✓样式" Click="CopyPageStyle2_Click" Tag="{Binding}"/>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="复制所有">
                                                    <MenuItem Header="【】样式" Click="CopyAllStyle1_Click" Tag="{Binding}"/>
                                                    <MenuItem Header="-✓样式" Click="CopyAllStyle2_Click" Tag="{Binding}"/>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧任务列表 -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 任务标题 -->
                <TextBlock Text="📝 任务" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,15" Grid.Row="0" Grid.Column="0"/>
                <!-- 任务列表 -->
                <ScrollViewer Grid.Row="1"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="800"
                              IsDeferredScrollingEnabled="True"
                              CanContentScroll="False">
                    <ListBox x:Name="TaskListBox"
                             ItemContainerStyle="{StaticResource TaskItemStyle}"
                             ItemsSource="{Binding CurrentDateTasks}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             DragEnter="TaskListBox_DragEnter"
                             DragOver="TaskListBox_DragOver"
                             Drop="TaskListBox_Drop"
                             DragLeave="TaskListBox_DragLeave"
                             PreviewMouseWheel="TaskListBox_PreviewMouseWheel"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             VirtualizingStackPanel.VirtualizationMode="Standard">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Stretch">
                                <Border Height="4" Margin="0,0,0,4" CornerRadius="2" Background="#4CAF50"
                                        Visibility="{Binding ShowDropBefore, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Border Background="White"
                                        Padding="12,0"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        Effect="{StaticResource ShadowEffect}"
                                        MouseLeftButtonDown="TaskItem_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制【】样式" Click="CopyTask_Click" Tag="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="删除" Click="DeleteTask_Click" Tag="{Binding}"/>
                                            <MenuItem Header="移动">
                                                <MenuItem Header="置顶" Click="MoveTaskToTop_Click" Tag="{Binding}" Visibility="{Binding IsFirst, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                                <MenuItem Header="置底" Click="MoveTaskToBottom_Click" Tag="{Binding}" Visibility="{Binding IsLast, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Not}"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2630;"
                                                   FontSize="16"
                                                   Foreground="#B0B0B0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"
                                                   Cursor="SizeAll"
                                                   ToolTip="拖拽排序"
                                                   PreviewMouseLeftButtonDown="TaskDragHandle_PreviewMouseLeftButtonDown"
                                                   PreviewMouseMove="TaskDragHandle_PreviewMouseMove"
                                                   PreviewMouseLeftButtonUp="TaskDragHandle_PreviewMouseLeftButtonUp"/>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  Click="CheckBox_Click"/>
                                        <Button Content="📝"
                                                FontSize="15"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="ToggleDetails_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#999"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Style="{StaticResource InputTextBoxStyle}"
                                                   FontSize="15"
                                                   VerticalAlignment="Top"
                                                   VerticalContentAlignment="Top"
                                                   Grid.Column="3"
                                                   HorizontalAlignment="Stretch"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   TextWrapping="Wrap"
                                                   HorizontalScrollBarVisibility="Disabled"
                                                   VerticalScrollBarVisibility="Auto"
                                                   GotFocus="TaskContent_GotFocus"
                                                   LostFocus="TaskContent_LostFocus"/>
                                        <Button Content="-"
                                                Click="DeleteTask_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                Grid.Column="4"
                                                FontSize="20"
                                                FontWeight="Bold"/>
                                        <Button Content="+"
                                                Click="AddTaskAfter_Click"
                                                Tag="{Binding}"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                Grid.Column="5"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="#4CAF50"/>
                                    </Grid>
                                </Border>

                                <!-- 详情框 -->
                                <Border Background="#ffffff"
                                        Padding="12"
                                        CornerRadius="8"
                                        Margin="0,5,0,0"
                                        BorderBrush="#e0e0e0"
                                        BorderThickness="1"
                                        Effect="{StaticResource ShadowEffect}"
                                        Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBox Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontSize="15"
                                             Foreground="#0f0f0f"
                                             Padding="2"
                                             VerticalContentAlignment="Top"
                                             HorizontalScrollBarVisibility="Disabled"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="50" FontFamily="Microsoft YaHei"
                                             GotFocus="TaskDetails_GotFocus"
                                             LostFocus="TaskDetails_LostFocus"/>
                                </Border>
                                <Border Height="4" Margin="0,6,0,0" CornerRadius="2" Background="#4CAF50"
                                        Visibility="{Binding ShowDropAfter, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- 想法标题 -->
                <TextBlock Text="💡 想法" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="15,0,0,15" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom"/>
                
                <!-- AI提示词与想法栏 -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" Effect="{StaticResource ShadowEffect}" CornerRadius="12" Padding="15" Margin="15,0,0,0">
                    <StackPanel>
                        <!-- 想法栏 -->
                        <TextBox Text="{Binding ThoughtContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Height="240"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"
                                 VerticalContentAlignment="Top"/>
                        
                        <!-- AI提示词 -->
                        <TextBlock Text="⚡ 快捷输入" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding AIPrompts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Width="255" HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,5,5">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="编辑" Click="EditAIPrompt_Click" Tag="{Binding}"/>
                                                <MenuItem Header="删除" Click="DeleteAIPrompt_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Button Content="{Binding Name}"
                                                Width="80"
                                                Padding="8,5"
                                                Background="{Binding Color}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="12"
                                                Click="AIPrompt_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 新增快捷输入"
                                Click="AddAIPrompt_Click"
                                Margin="0,10,0,0"
                                Padding="12,10"
                                Background="#607D8B"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Width="170">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</Window>
